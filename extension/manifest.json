{
  "manifest_version": 3,
  "name": "Coffee? – LinkedIn Contact Importer",
  "version": "1.0.0",
  "description": "Scrape LinkedIn profiles and add contacts to Coffee? with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Coffee? Contact Importer"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.linkedin.com/in/*",
    "https://ypyvkqysnowgegcjydnd.supabase.co/*"
  ]
}
